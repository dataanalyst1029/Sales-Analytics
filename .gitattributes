# Files that run on the Linux server must keep LF endings, even when committed
# from a Windows checkout with core.autocrlf=true -- a CRLF breaks sh and systemd.
*.sh       text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.conf     text eol=lf
# And the Windows launchers stay CRLF wherever they are checked out.
*.cmd      text eol=crlf
