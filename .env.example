# Copy to .env and fill in. .env is gitignored -- keep the real token out of git.

# Base URL of the internal transactions API, no trailing slash.
#   e.g. https://api.example.com  or  https://api.example.com/v1
API_BASE_URL=

# How the API authenticates. One of: bearer | header | basic | query | none
API_AUTH_MODE=bearer

# bearer -> sent as   Authorization: Bearer <API_TOKEN>
# header -> sent as   <API_AUTH_HEADER>: <API_TOKEN>
# query  -> sent as   ?<API_AUTH_PARAM>=<API_TOKEN>
API_TOKEN=

# Only for API_AUTH_MODE=header
API_AUTH_HEADER=X-API-Key

# Only for API_AUTH_MODE=query
API_AUTH_PARAM=api_key

# Only for API_AUTH_MODE=basic
API_USER=
API_PASSWORD=

# Optional: extra headers as JSON, e.g. {"X-Tenant": "ribshack"}
API_EXTRA_HEADERS=
